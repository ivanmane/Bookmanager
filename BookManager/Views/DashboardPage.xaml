<Page
    x:Class="BookManager.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{StaticResource BrushFondoGeneral}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Encabezado del Dashboard -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAzulMarino}" />
                    <TextBlock Text="Panel general de inventario y seguimiento de biblioteca"
                               FontSize="14"
                               Foreground="{StaticResource BrushTextoSecundario}" />
                </StackPanel>

                <!-- Accesos rápidos superiores -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Catálogo →"
                            Style="{StaticResource BotonSecundarioStyle}"
                            Click="IndicadorTotal_Click" />
                    <Button Content="Lectores →"
                            Style="{StaticResource BotonSecundarioStyle}"
                            Click="BtnVerLectores_Click" />
                    <Button Content="Préstamos →"
                            Style="{StaticResource BotonAcentoStyle}"
                            Click="BtnVerPrestamos_Click" />
                    <Button Content="Cerrar sesión"
                            Style="{StaticResource BotonSecundarioStyle}"
                            Click="BtnCerrarSesion_Click" />
                </StackPanel>
            </Grid>

            <!-- 2. Mensaje de estado / carga / error -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="PrgCarga"
                              IsActive="True"
                              Width="18"
                              Height="18" />
                <TextBlock x:Name="TxtMensajeEstado"
                           Text="Cargando información..."
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource BrushTextoSecundario}" />
            </StackPanel>

            <!-- 3. Los 4 Indicadores de Inventario (Tarjetas compactas) -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Total de ejemplares -->
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="IndicadorTotal_Click">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorde}"
                            CornerRadius="8"
                            Padding="18,14"
                            Background="{StaticResource BrushSuperficie}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE82D;" FontSize="14" Foreground="{StaticResource BrushAzulMarino}" />
                                <TextBlock Text="Total ejemplares"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoSecundario}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalLibros"
                                       Text="-"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushAzulMarino}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- 2. Ejemplares disponibles -->
                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="IndicadorDisponibles_Click">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorde}"
                            CornerRadius="8"
                            Padding="18,14"
                            Background="{StaticResource BrushSuperficie}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource BrushExito}" />
                                <TextBlock Text="Disponibles"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoSecundario}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtLibrosDisponibles"
                                       Text="-"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushExito}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- 3. Ejemplares prestados -->
                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="IndicadorPrestados_Click">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorde}"
                            CornerRadius="8"
                            Padding="18,14"
                            Background="{StaticResource BrushSuperficie}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{StaticResource BrushAzulSecundario}" />
                                <TextBlock Text="Prestados"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoSecundario}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtLibrosPrestados"
                                       Text="-"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushAzulSecundario}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- 4. Ejemplares vencidos -->
                <Button Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="IndicadorVencidos_Click">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorde}"
                            CornerRadius="8"
                            Padding="18,14"
                            Background="{StaticResource BrushSuperficie}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource BrushError}" />
                                <TextBlock Text="Vencidos"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextoSecundario}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtLibrosVencidos"
                                       Text="-"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushError}" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- 4. Sección: Préstamos pendientes de devolución -->
            <Border Grid.Row="3"
                    Background="{StaticResource BrushSuperficie}"
                    BorderBrush="{StaticResource BrushBorde}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Préstamos pendientes de devolución"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextoPrincipal}" />
                        <TextBlock Text="Listado priorizado para contacto y seguimiento de ejemplares en préstamo activo."
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextoSecundario}" />
                    </StackPanel>

                    <!-- Mensaje cuando no hay préstamos activos -->
                    <TextBlock x:Name="TxtSinPrestamos"
                               Text="No hay préstamos pendientes de devolución en este momento."
                               FontSize="14"
                               Foreground="{StaticResource BrushTextoSecundario}"
                               FontStyle="Italic"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <!-- Contenedor de la tabla -->
                    <StackPanel x:Name="ContenedorTablaPrestamos" Spacing="0">
                        <!-- Encabezado de la tabla -->
                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BrushBorde}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="115" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Libro" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="1" Text="Lector" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="2" Text="Matrícula" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="3" Text="F. Préstamo" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="4" Text="Vencimiento" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="5" Text="Estado / Retraso" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="6" Text="Correo" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="7" Text="Teléfono" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                            </Grid>
                        </Border>

                        <!-- Filas de préstamos activos -->
                        <ListView x:Name="ListaPrestamosPendientes"
                                  SelectionMode="None"
                                  BorderBrush="{StaticResource BrushBorde}"
                                  BorderThickness="1"
                                  CornerRadius="0,0,6,6"
                                  MinHeight="100"
                                  MaxHeight="380">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="115" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TituloLibro}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextoPrincipal}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NombreLector}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextoPrincipal}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MatriculaLector}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FechaPrestamoTexto}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" />
                                        <TextBlock Grid.Column="4" Text="{Binding FechaVencimientoTexto}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoPrincipal}" />
                                        <Border Grid.Column="5"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorFondoEstado}">
                                            <TextBlock Text="{Binding EstadoRetraso}"
                                                       Foreground="{Binding ColorTextoEstado}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="6" Text="{Binding CorreoLector}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextoSecundario}" />
                                        <TextBlock Grid.Column="7" Text="{Binding TelefonoLector}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
