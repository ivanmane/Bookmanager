<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BookManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BookManager"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Paleta institucional BookManager -->
            <Color x:Key="ColorAzulMarino">#163B70</Color>
            <Color x:Key="ColorAzulSecundario">#245A96</Color>
            <Color x:Key="ColorTurquesaAcento">#14B8A6</Color>
            <Color x:Key="ColorFondoGeneral">#F4F6FA</Color>
            <Color x:Key="ColorSuperficie">#FFFFFF</Color>
            <Color x:Key="ColorTextoPrincipal">#1F2937</Color>
            <Color x:Key="ColorTextoSecundario">#64748B</Color>
            <Color x:Key="ColorBorde">#CBD5E1</Color>
            <Color x:Key="ColorExito">#15803D</Color>
            <Color x:Key="ColorAdvertencia">#B45309</Color>
            <Color x:Key="ColorError">#B91C1C</Color>

            <!-- Pinceles (Brushes) para uso en XAML -->
            <SolidColorBrush x:Key="BrushAzulMarino" Color="{StaticResource ColorAzulMarino}" />
            <SolidColorBrush x:Key="BrushAzulSecundario" Color="{StaticResource ColorAzulSecundario}" />
            <SolidColorBrush x:Key="BrushTurquesaAcento" Color="{StaticResource ColorTurquesaAcento}" />
            <SolidColorBrush x:Key="BrushFondoGeneral" Color="{StaticResource ColorFondoGeneral}" />
            <SolidColorBrush x:Key="BrushSuperficie" Color="{StaticResource ColorSuperficie}" />
            <SolidColorBrush x:Key="BrushTextoPrincipal" Color="{StaticResource ColorTextoPrincipal}" />
            <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource ColorTextoSecundario}" />
            <SolidColorBrush x:Key="BrushBorde" Color="{StaticResource ColorBorde}" />
            <SolidColorBrush x:Key="BrushExito" Color="{StaticResource ColorExito}" />
            <SolidColorBrush x:Key="BrushAdvertencia" Color="{StaticResource ColorAdvertencia}" />
            <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />

            <!-- Pinceles de estado para badges de préstamos -->
            <SolidColorBrush x:Key="BadgeFondoDevuelto" Color="#EEF2FF" />
            <SolidColorBrush x:Key="BadgeTextoDevuelto" Color="#245A96" />
            <SolidColorBrush x:Key="BadgeFondoPendiente" Color="#ECFDF5" />
            <SolidColorBrush x:Key="BadgeTextoPendiente" Color="#15803D" />
            <SolidColorBrush x:Key="BadgeFondoVenceHoy" Color="#FEF3C7" />
            <SolidColorBrush x:Key="BadgeTextoVenceHoy" Color="#B45309" />
            <SolidColorBrush x:Key="BadgeFondoVencido" Color="#FEE2E2" />
            <SolidColorBrush x:Key="BadgeTextoVencido" Color="#B91C1C" />

            <!-- Tipografía predeterminada -->
            <FontFamily x:Key="FuenteApp">Segoe UI</FontFamily>

            <!-- Sobrescritura de recursos de sistema WinUI para forzar contraste en tema claro -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F8FAFC" />

            <SolidColorBrush x:Key="TextControlForeground" Color="#1F2937" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1F2937" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1F2937" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#94A3B8" />

            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#64748B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#64748B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#64748B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#94A3B8" />

            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#94A3B8" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#163B70" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F8FAFC" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F1F5F9" />

            <SolidColorBrush x:Key="ComboBoxForeground" Color="#1F2937" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#1F2937" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#1F2937" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#1F2937" />

            <SolidColorBrush x:Key="ComboBoxPlaceholderTextForeground" Color="#64748B" />
            <SolidColorBrush x:Key="ComboBoxPlaceholderTextForegroundPointerOver" Color="#64748B" />
            <SolidColorBrush x:Key="ComboBoxPlaceholderTextForegroundFocused" Color="#64748B" />

            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#94A3B8" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#163B70" />

            <SolidColorBrush x:Key="DatePickerButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DatePickerButtonBackgroundPointerOver" Color="#F8FAFC" />
            <SolidColorBrush x:Key="DatePickerButtonBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DatePickerButtonForeground" Color="#1F2937" />
            <SolidColorBrush x:Key="DatePickerButtonForegroundPointerOver" Color="#1F2937" />
            <SolidColorBrush x:Key="DatePickerButtonForegroundFocused" Color="#1F2937" />
            <SolidColorBrush x:Key="DatePickerButtonBorderBrush" Color="#CBD5E1" />

            <!-- Estilos de botones unificados -->
            <Style x:Key="BotonPrimarioStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushAzulMarino}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="BotonAcentoStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushTurquesaAcento}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="BotonSecundarioStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextoPrincipal}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,7" />
            </Style>

            <Style x:Key="BotonPeligroStyle" TargetType="Button">
                <Setter Property="Background" Value="#FEE2E2" />
                <Setter Property="Foreground" Value="{StaticResource BrushError}" />
                <Setter Property="BorderBrush" Value="#FECACA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
