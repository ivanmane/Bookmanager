<Page
    x:Class="BookManager.Views.LectoresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{StaticResource BrushFondoGeneral}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Gestión de lectores"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAzulMarino}" />
                    <TextBlock x:ConnectionId='19' x:Name="TxtTotalResultados"
                               Text="Cargando lectores..."
                               FontSize="13"
                               Foreground="{StaticResource BrushTextoSecundario}" />
                </StackPanel>

                <Button x:ConnectionId='18' Grid.Column="1"
                        x:Name="BtnVolver"
                        Content="← Volver al Dashboard"
                        Style="{StaticResource BotonSecundarioStyle}"
                        VerticalAlignment="Top"
                                                />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='14' Grid.Column="0"
                         x:Name="TxtBuscar"
                         PlaceholderText="Buscar por nombre, matrícula, correo o teléfono..."
                         MaxLength="100"
                         Background="{StaticResource BrushSuperficie}"
                         Foreground="{StaticResource BrushTextoPrincipal}"
                         PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                         BorderBrush="{StaticResource BrushBorde}"
                         BorderThickness="1"
                         CornerRadius="6"
                                                                               
                                                             />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='15' x:Name="BtnAgregar"
                            Content="+ Agregar lector"
                            Style="{StaticResource BotonAcentoStyle}"
                                                     />
                    <Button x:ConnectionId='16' x:Name="BtnEditar"
                            Content="Editar"
                            Style="{StaticResource BotonSecundarioStyle}"
                            IsEnabled="False"
                                                    />
                    <Button x:ConnectionId='17' x:Name="BtnEliminar"
                            Content="Eliminar"
                            Style="{StaticResource BotonPeligroStyle}"
                            IsEnabled="False"
                                                      />
                </StackPanel>
            </Grid>

            <TextBlock x:ConnectionId='2' Grid.Row="2"
                       x:Name="TxtMensajeEstado"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Visibility="Collapsed" />

            <Border x:ConnectionId='3' Grid.Row="3"
                    x:Name="PanelFormulario"
                    Visibility="Collapsed"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrushBorde}"
                    CornerRadius="8"
                    Padding="24"
                    Background="{StaticResource BrushSuperficie}">
                <StackPanel Spacing="16">
                    <TextBlock x:ConnectionId='6' x:Name="TxtTituloFormulario"
                               Text="Registrar nuevo lector"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAzulMarino}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Nombre completo (* obligatorio):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoPrincipal}" />
                            <TextBox x:ConnectionId='13' x:Name="TxtNombre"
                                     PlaceholderText="Ej: Juan Pérez González"
                                     MaxLength="100"
                                     Background="{StaticResource BrushSuperficie}"
                                     Foreground="{StaticResource BrushTextoPrincipal}"
                                     PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                                     BorderBrush="{StaticResource BrushBorde}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                                                                           
                                                                                      />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Matrícula / Credencial (* obligatoria):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoPrincipal}" />
                            <TextBox x:ConnectionId='12' x:Name="TxtMatricula"
                                     PlaceholderText="Ej: MAT-2026-01"
                                     MaxLength="20"
                                     Background="{StaticResource BrushSuperficie}"
                                     Foreground="{StaticResource BrushTextoPrincipal}"
                                     PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                                     BorderBrush="{StaticResource BrushBorde}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                                                                           
                                                                                      />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Correo electrónico (* obligatorio):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoPrincipal}" />
                            <TextBox x:ConnectionId='11' x:Name="TxtCorreo"
                                     PlaceholderText="Ej: juan.perez@universidad.edu.mx"
                                     MaxLength="100"
                                     InputScope="EmailSmtpAddress"
                                     Background="{StaticResource BrushSuperficie}"
                                     Foreground="{StaticResource BrushTextoPrincipal}"
                                     PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                                     BorderBrush="{StaticResource BrushBorde}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                                                                           
                                                                                      />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Teléfono (* obligatorio, 10 dígitos):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextoPrincipal}" />
                            <TextBox x:ConnectionId='10' x:Name="TxtTelefono"
                                     PlaceholderText="Ej: 8145899327"
                                     InputScope="TelephoneNumber"
                                     MaxLength="10"
                                     Background="{StaticResource BrushSuperficie}"
                                     Foreground="{StaticResource BrushTextoPrincipal}"
                                     PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                                     BorderBrush="{StaticResource BrushBorde}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                                                                           
                                                                                      />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:ConnectionId='7' x:Name="TxtErrorFormulario"
                               Foreground="{StaticResource BrushError}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button x:ConnectionId='8' x:Name="BtnCancelarFormulario"
                                Content="Cancelar"
                                Style="{StaticResource BotonSecundarioStyle}"
                                                                    />
                        <Button x:ConnectionId='9' x:Name="BtnGuardarLector"
                                Content="Guardar"
                                Style="{StaticResource BotonPrimarioStyle}"
                                                               />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Spacing="0">
                <Border Background="#F8FAFC"
                        BorderBrush="{StaticResource BrushBorde}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                        <TextBlock Grid.Column="1" Text="Nombre" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                        <TextBlock Grid.Column="2" Text="Matrícula" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                        <TextBlock Grid.Column="3" Text="Correo" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                        <TextBlock Grid.Column="4" Text="Teléfono" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextoSecundario}" />
                    </Grid>
                </Border>

                <ListView x:ConnectionId='4' x:Name="ListaLectores"
                          SelectionMode="Single"
                                                                           
                          Background="{StaticResource BrushSuperficie}"
                          BorderBrush="{StaticResource BrushBorde}"
                          BorderThickness="1"
                          CornerRadius="0,0,6,6"
                          MinHeight="200"
                          MaxHeight="460">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextoPrincipal}" />
                                <TextBlock Grid.Column="2" Text="{Binding Matricula}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="3" Text="{Binding Correo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextoSecundario}" />
                                <TextBlock Grid.Column="4" Text="{Binding Telefono}" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoPrincipal}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

