<Page
    x:Class="BookManager.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{StaticResource BrushFondoGeneral}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
        <Border Width="380"
                Background="{StaticResource BrushSuperficie}"
                BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="36,40">
            <StackPanel Spacing="20">
                <Image Source="ms-appx:///Assets/BookManager.png"
                       Width="84"
                       Height="84"
                       HorizontalAlignment="Center" />

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="BookManager"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushAzulMarino}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Gestión de Biblioteca"
                               FontSize="14"
                               Foreground="{StaticResource BrushTextoSecundario}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Usuario"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextoPrincipal}" />
                    <TextBox x:ConnectionId='5' x:Name="TxtUsuario"
                             PlaceholderText="Ingrese su usuario"
                             MaxLength="30"
                             Background="{StaticResource BrushSuperficie}"
                             Foreground="{StaticResource BrushTextoPrincipal}"
                             PlaceholderForeground="{StaticResource BrushTextoSecundario}"
                             BorderBrush="{StaticResource BrushBorde}"
                             BorderThickness="1"
                             CornerRadius="6"
                                                                                   
                                                                              />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Contraseña"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextoPrincipal}" />
                    <PasswordBox x:ConnectionId='4' x:Name="TxtPassword"
                                 PlaceholderText="Ingrese su contraseña"
                                 MaxLength="30"
                                 Background="{StaticResource BrushSuperficie}"
                                 Foreground="{StaticResource BrushTextoPrincipal}"
                                 BorderBrush="{StaticResource BrushBorde}"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                                                         
                                                                            />
                </StackPanel>

                <Button x:ConnectionId='2' x:Name="BtnIngresar"
                        Content="Ingresar al sistema"
                        Style="{StaticResource BotonPrimarioStyle}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Margin="0,8,0,0"
                                                  />

                <TextBlock x:ConnectionId='3' x:Name="TxtMensaje"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="13"
                           FontWeight="Medium" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

